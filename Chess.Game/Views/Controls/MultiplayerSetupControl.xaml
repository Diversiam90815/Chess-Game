<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Chess.UI.Views.Controls.MultiplayerSetupControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:Chess.UI.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Rootgrid">

        <!-- Init View: Show player name + Find Opponent button -->
        <StackPanel
            Name="InitView"
            Orientation="Vertical"
            Spacing="8"
            Visibility="{x:Bind _viewModel.InitView, Mode=OneWay}">

            <!-- Settings -->
            <StackPanel
                Margin="20,0"
                HorizontalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Your name" />
                <TextBlock
                    Margin="0,8"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{x:Bind _viewModel.LocalPlayerName, Mode=OneWay}" />
                <TextBlock
                    Margin="20,8"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="You can change your name and network in Settings > Multiplayer"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                Name="FindOpponentButton"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Click="FindOpponentButton_Click"
                Content="Find Opponent"
                Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>


        <!-- Searching: Looking for opponents -->
        <StackPanel
            Name="SearchingView"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Spacing="16"
            Visibility="{x:Bind _viewModel.SearchingView, Mode=OneWay}">

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                Text="Searching for opponents..." />
            <ProgressRing
                Width="40"
                Height="40"
                IsActive="True" />
            <Button
                Name="CancelSearchButton"
                HorizontalAlignment="Center"
                Click="CancelSearchButton_Click"
                Content="Cancel" />
        </StackPanel>


        <!-- Opponent Found: Show discovered opponents list -->
        <StackPanel
            Name="OpponentFoundView"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Spacing="16"
            Visibility="{x:Bind _viewModel.OpponentFoundView, Mode=OneWay}">

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Opponents found" />

            <ListView
                MaxHeight="200"
                HorizontalAlignment="Center"
                ItemsSource="{x:Bind _viewModel.DiscoveredOpponents, Mode=OneWay}"
                SelectedIndex="{x:Bind _viewModel.SelectedOpponentIndex, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock
                            Padding="8,4"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    Name="ConnectButton"
                    Click="ConnectButton_Click"
                    Content="Connect"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    Name="CancelConnectButton"
                    Click="CancelSearchButton_Click"
                    Content="Cancel" />
            </StackPanel>
        </StackPanel>


        <!-- Connection Requested: Someone wants to connect to us -->
        <StackPanel
            Name="ConnectionRequestedView"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Spacing="24"
            Visibility="{x:Bind _viewModel.ConnectionRequestedView, Mode=OneWay}">

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{x:Bind _viewModel.RemotePlayerName, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="wants to connect. Accept?" />

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    Name="AcceptButton"
                    Click="AcceptButton_Click"
                    Content="Accept"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    Name="DeclineButton"
                    Click="DeclineButton_Click"
                    Content="Decline" />
            </StackPanel>
        </StackPanel>


        <!-- Waiting for Response: We sent a connection request -->
        <StackPanel
            Name="WaitingForResponseView"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Spacing="16"
            Visibility="{x:Bind _viewModel.WaitingForResponseView, Mode=OneWay}">

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                Text="Connecting to" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Text="{x:Bind _viewModel.RemotePlayerName, Mode=OneWay}" />
            <ProgressRing
                Width="40"
                Height="40"
                Margin="0,8,0,0" />
            <Button
                Name="AbortConnectionButton"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Click="CancelSearchButton_Click"
                Content="Cancel" />
        </StackPanel>


        <!-- Player color selection + Ready -->
        <StackPanel
            Name="SettingPlayerColorView"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Spacing="16"
            Visibility="{x:Bind _viewModel.SettingLocalPlayerView, Mode=TwoWay}">

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                Text="Select your color" />

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="24">

                <!-- White King Button -->
                <StackPanel HorizontalAlignment="Center">
                    <Button
                        Name="SelectWhiteButton"
                        Width="80"
                        Height="80"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="{x:Bind converter:Converter.PlayerToWhiteBorderThickness(_viewModel.LocalPlayer), Mode=OneWay}"
                        Click="SelectWhiteButton_Click"
                        CornerRadius="8">
                        <Image Source="ms-appx:///Assets/Pieces/Standard/WKing.png" Stretch="Uniform" />
                    </Button>
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Text="White" />
                </StackPanel>

                <!-- Black King Button -->
                <StackPanel HorizontalAlignment="Center">
                    <Button
                        Name="SelectBlackButton"
                        Width="80"
                        Height="80"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="{x:Bind converter:Converter.PlayerToBlackBorderThickness(_viewModel.LocalPlayer), Mode=OneWay}"
                        Click="SelectBlackButton_Click"
                        CornerRadius="8">
                        <Image Source="ms-appx:///Assets/Pieces/Standard/BKing.png" Stretch="Uniform" />
                    </Button>
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Text="Black" />
                </StackPanel>
            </StackPanel>

            <!-- Ready Button -->
            <Button
                Name="ReadyButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Click="ReadyButton_Click"
                Content="I'm Ready!"
                IsEnabled="{x:Bind _viewModel.ReadyButtonEnabled, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}" />

            <!-- Waiting for other player -->
            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Orientation="Vertical"
                Visibility="{x:Bind converter:Converter.BoolToVisibility(_viewModel.IsReady), Mode=OneWay}">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Waiting for other player..." />
                <ProgressRing
                    Width="24"
                    Height="24"
                    Margin="0,8,0,0"
                    IsActive="True" />
            </StackPanel>
        </StackPanel>

    </Grid>
</UserControl>
